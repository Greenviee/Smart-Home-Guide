    "thermo":   {"name": "온습도 센서",        "price": 19000,  "priority": 2, "image": "thermo.svg",   "desc": "실내 온도·습도를 기록하고 냉난방 자동화에 활용합니다."},
    "gas":      {"name": "가스 누출 감지기",   "price": 39000,  "priority": 1, "image": "gas.svg",      "desc": "가스가 새면 경보음과 함께 휴대폰으로 알립니다."},
    "valve":    {"name": "스마트 가스밸브",    "price": 69000,  "priority": 2, "image": "valve.svg",    "desc": "외출 후에도 앱으로 가스 밸브를 잠급니다."},
    "smoke":    {"name": "연기 감지기",        "price": 29000,  "priority": 1, "image": "smoke.svg",    "desc": "화재 초기에 연기를 감지해 경보를 울립니다."},
    "leak":     {"name": "누수 센서",          "price": 19000,  "priority": 1, "image": "leak.svg",     "desc": "바닥에 물이 닿으면 즉시 알려 침수 피해를 막습니다."},
    "energy":   {"name": "전력량 모니터",      "price": 49000,  "priority": 2, "image": "energy.svg",   "desc": "집 전체 전력 사용량을 실시간으로 보여줍니다."},
    "petcam":   {"name": "펫 카메라",          "price": 79000,  "priority": 2, "image": "petcam.svg",   "desc": "반려동물을 지켜보고 대화하며 간식을 줄 수 있습니다."},
    "feeder":   {"name": "자동 급식기",        "price": 99000,  "priority": 3, "image": "feeder.svg",   "desc": "정해진 시간에 정량의 사료를 급여합니다."},
    "fall":     {"name": "낙상 감지 센서",     "price": 149000, "priority": 1, "image": "fall.svg",     "desc": "레이더로 넘어짐을 감지해 가족에게 알립니다."},
    "sos":      {"name": "비상 호출 버튼",     "price": 25000,  "priority": 1, "image": "sos.svg",      "desc": "누르면 등록된 가족에게 즉시 호출 알림을 보냅니다."}
  },
  "rules": [
    {"group": "base",     "when": {"always": true},                              "reason": "모든 스마트 기기의 기반",            "products": [{"id": "hub"}, {"id": "plug", "qty": 2}]},
    {"group": "base",     "when": {"min_area": 30},                              "reason": "30평 이상은 Wi-Fi 음영 구역이 생김",  "products": [{"id": "mesh"}]},
    {"group": "base",     "when": {"housing": ["house"]},                        "reason": "단독주택은 층·벽이 많아 신호가 약함", "products": [{"id": "mesh"}]},
    {"group": "entrance", "when": {"space": "entrance"},                         "reason": "현관 출입 관리",                     "products": [{"id": "doorlock"}, {"id": "motion"}]},
    {"group": "living",   "when": {"space": "living"},                           "reason": "가족이 가장 오래 머무는 공간",        "products": [{"id": "light"}, {"id": "air"}, {"id": "ir"}]},
    {"group": "kitchen",  "when": {"space": "kitchen"},                          "reason": "불과 가스를 쓰는 공간",              "products": [{"id": "gas"}, {"id": "smoke"}]},
    {"group": "bedroom",  "when": {"space": "bedroom"},                          "reason": "방마다 수면 조명과 온습도 관리",      "products": [{"id": "bulb", "qty": "rooms"}, {"id": "thermo", "qty": "rooms"}]},
    {"group": "study",    "when": {"space": "study"},                            "reason": "집중을 위한 조명·공기 관리",          "products": [{"id": "bulb"}, {"id": "air"}]},
    {"group": "bathroom", "when": {"space": "bathroom"},                         "reason": "물을 쓰는 공간의 누수 대비",          "products": [{"id": "leak"}]},
    {"group": "balcony",  "when": {"space": "balcony"},                          "reason": "세탁기 누수와 창문 열림 확인",        "products": [{"id": "leak"}, {"id": "contact"}]},
    {"group": "care",     "when": {"household": "pet"},                          "reason": "혼자 있는 반려동물 돌봄",            "products": [{"id": "petcam"}, {"id": "feeder"}]},
    {"group": "care",     "when": {"household": "elderly"},                      "reason": "노약자의 응급 상황 대비",            "products": [{"id": "fall"}, {"id": "sos"}]},
    {"group": "care",     "when": {"household": "child"},                        "reason": "아이 방 확인과 안전",                "products": [{"id": "cctv"}, {"id": "contact"}, {"id": "smoke"}]},
    {"group": "care",     "when": {"household": "single", "priority": "security"}, "reason": "1인 가구 외출 중 집 확인",         "products": [{"id": "cctv"}]},
    {"group": "extra",    "when": {"priority": "security"},                      "reason": "보안 우선: 침입 감지",               "products": [{"id": "contact", "qty": "rooms"}, {"id": "cctv"}]},
    {"group": "extra",    "when": {"priority": "security", "housing": ["house"]}, "reason": "단독주택 외부 감시",                "products": [{"id": "outdoor"}]},
    {"group": "extra",    "when": {"priority": "energy"},                        "reason": "에너지 절약: 대기전력 차단과 사용량 확인", "products": [{"id": "plug", "qty": 4}, {"id": "energy"}]},
    {"group": "extra",    "when": {"priority": "convenience"},                   "reason": "생활 편의: 음성 제어",               "products": [{"id": "speaker"}]},
    {"group": "extra",    "when": {"priority": "convenience", "space": "living"}, "reason": "생활 편의: 커튼 자동화",            "products": [{"id": "curtain"}]},
    {"group": "extra",    "when": {"priority": "safety"},                        "reason": "안전 우선: 화재 조기 감지",           "products": [{"id": "smoke"}]},
    {"group": "extra",    "when": {"priority": "safety", "space": "kitchen"},    "reason": "안전 우선: 가스 원격 차단",           "products": [{"id": "valve"}]}
  ]
}
